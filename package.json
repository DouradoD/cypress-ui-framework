    "cy:run:all": "cypress run --browser chrome",
    "cy:clean:reports": "node -e \"const fs=require('fs');const p=require('path');['cypress/reports/cucumber-json','cypress/reports/cucumber-html'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true});console.log('Cleaned '+d)}})\"",
